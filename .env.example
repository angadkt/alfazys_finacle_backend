# ============================================================
# INFAZYS Backend — Environment Variables
# Copy this file:  cp .env.example .env
# NEVER commit .env to Git.
# ============================================================

# === REQUIRED ===
DATABASE_URL=postgresql://user:password@localhost:5432/finance
JWT_SECRET=change-me-generate-with-openssl-rand-hex-32-must-be-at-least-32-chars
DOC_ENCRYPTION_KEY=change-me-32-char-key-or-64-hex

# === OPTIONAL (have defaults) ===
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173
UPLOAD_DIR=./uploads
SESSION_HOURS=8
