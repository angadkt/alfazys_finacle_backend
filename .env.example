# ============================================================
# INFAZYS Backend — Environment Variables
# Copy this file:  cp .env.example .env
# NEVER commit .env to Git.
# ============================================================

# === REQUIRED ===
DATABASE_URL=postgresql://user:password@localhost:5432/finance
JWT_SECRET=change-me-generate-with-openssl-rand-hex-32-must-be-at-least-32-chars
DOC_ENCRYPTION_KEY=change-me-32-char-key-or-64-hex

# === OPTIONAL (have defaults) ===
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173
UPLOAD_DIR=./uploads
SESSION_HOURS=8

# === SMTP Email Configuration (Staff Credentials Delivery) ===
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM="Infazys Finacle" <your-email@gmail.com>
PORTAL_URL=https://alfazys-finacle.vercel.app
